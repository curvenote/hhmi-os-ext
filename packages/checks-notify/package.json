{
  "name": "@hhmi/checks-notify",
  "private": true,
  "version": "0.1.0",
  "description": "Shared Slack notification helpers for HHMI check extensions",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "browser": false,
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "lint": "bunx eslint -c ../../.eslintrc.cjs \"src/**/*.ts\"",
    "lint:format": "prettier --check \"src/**/*.ts\"",
    "lint:format:fix": "prettier --write \"src/**/*.ts\"",
    "build": "tsc --project tsconfig.json",
    "compile": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@curvenote/scms-core": "*",
    "@curvenote/scms-db": "*",
    "@curvenote/scms-server": "*"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "eslint-config-curvenote": "^0.0.4",
    "prettier": "^3.5.3",
    "typescript": "^5.6.3",
    "vitest": "^4.1.3"
  },
  "engines": {
    "node": ">=22.21.0",
    "bun": ">=1.3.10"
  }
}
