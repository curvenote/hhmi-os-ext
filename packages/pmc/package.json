{
  "name": "@hhmi/pmc",
  "version": "0.2.2",
  "description": "PMC extension for the HHMI Workspace - powered by Curvenote.",
  "author": "Curvenote <support@curvenote.com>",
  "homepage": "https://github.com/HHMI-HQ/hhmi-workspace",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "browser": false,
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "development": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.js",
      "default": "./dist/client.js"
    }
  },
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HHMI-HQ/hhmi-workspace.git"
  },
  "scripts": {
    "prepush": "bun run lint:format:fix; bun run lint:circular; bun run lint; bun run compile; bun run test:ci; bun run test:unit; bun run test:integration",
    "pp": "bun run prepush",
    "clean": "rimraf dist _build api && find . -name '.turbo' -type d -prune -exec rm -rf '{}' +",
    "lint": "bunx eslint \"src/**/*.{ts,tsx}\"",
    "lint:format": "prettier --check \"src/**/*.{ts,tsx}\"",
    "lint:format:fix": "prettier --write \"src/**/*.{ts,tsx}\"",
    "lint:circular": "bunx madge --circular --extensions ts,tsx src",
    "config": "bunx @app-config/cli@2 generate",
    "build": "bun run build:server && bun run build:client",
    "build:server": "tsc --project tsconfig.json",
    "build:client": "tsup",
    "dev": "tsc -w",
    "compile": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --reporter=verbose",
    "changeset": "changeset",
    "version": "changeset version && bun install"
  },
  "bugs": {
    "url": "https://github.com/curvenote/journals/issues"
  },
  "dependencies": {
    "@curvenote/common": "^0.4.2",
    "@curvenote/scms-core": "*",
    "@curvenote/scms-server": "*",
    "@curvenote/scms-db": "*",
    "@google-cloud/pubsub": "^5.2.0",
    "@react-email/components": "0.5.7",
    "@react-router/dev": "7.18.2",
    "date-fns": "3.6.0",
    "fuse.js": "^7.1.0",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.552.0",
    "myst-common": "^1.9.5",
    "pmc-utils": "0.3.1",
    "react": "^18.3.1",
    "react-router": "7.18.2",
    "uuidv7": "^1.0.2",
    "zod": "^4.1.12",
    "zod-form-data": "^3.0.1",
    "@react-router/node": "7.18.2"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "^0.25.1",
    "@rollup/rollup-linux-x64-gnu": "^4.35.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@react-router/serve": "7.18.2",
    "@tailwindcss/postcss": "^4.0.14",
    "@types/color": "^4.2.0",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/md5": "^2.3.5",
    "@types/node": "^22.19.0",
    "@types/nprogress": "^0.2.3",
    "@types/numeral": "^2.0.5",
    "@types/react": "^18.3.18",
    "@types/react-datepicker": "^6.2.0",
    "@types/react-dom": "^18.3.5",
    "@types/semver": "^7.5.8",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "concurrently": "^9.1.2",
    "dotenv-cli": "^11.0.0",
    "eslint-config-curvenote": "^0.0.4",
    "glob": "^11.1.0",
    "madge": "^8.0.0",
    "prettier": "^3.5.3",
    "prettier-eslint": "^16.3.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.3",
    "typescript": "^5.6.3",
    "vitest": "^4.0.6",
    "vite": "^7.1.12"
  },
  "prisma": {
    "seed": "tsx prisma/seed.mts"
  },
  "engines": {
    "node": ">=22.21.0",
    "bun": ">=1.3.10"
  },
  "packageManager": "bun@1.3.10"
}
