{
  "name": "@hhmi/proofig-pdf-service",
  "version": "0.0.1",
  "description": "Nodejs server that renders a Proofig report URL to PDF and stores it back on workspace storage",
  "type": "module",
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "private": true,
  "publishConfig": {
    "access": "restricted"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "gcp-build": "bun run build",
    "clean": "rm -rf dist",
    "build": "esbuild src/index.ts --outfile=dist/index.js --bundle --platform=node --external:fsevents --external:playwright --external:playwright-core --loader:.node=copy",
    "build:watch": "esbuild src/index.ts --outfile=dist/index.js --bundle --platform=node --watch --external:fsevents --external:playwright --external:playwright-core",
    "start": "node ./dist/index.js",
    "dev": "bun run clean; bun run build; NODE_ENV=development concurrently \"bun run build:watch\" \"nodemon\"",
    "lint": "eslint \"src/**/*.ts\" -c ./.eslintrc.cjs",
    "lint:format": "bunx prettier --check \"src/**/*.ts\"",
    "lint:format:fix": "bunx prettier --write \"src/**/*.ts\"",
    "compile": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@curvenote/scms-tasks": "*",
    "express": "^4.18.1",
    "playwright": "^1.49.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^4.17.13",
    "@types/node": "^22.19.0",
    "concurrently": "^9.1.0",
    "dotenv": "^16.0.1",
    "esbuild": "^0.25.1",
    "eslint": "^8.21.0",
    "eslint-config-curvenote": "^0.0.4",
    "nodemon": "^3.1.0",
    "typescript": "^5.6.3",
    "vitest": "^4.0.6"
  },
  "nodemonConfig": {
    "signal": "SIGHUP",
    "ignore": [
      "**/*.test.ts",
      "**/*.spec.ts",
      ".git",
      "node_modules"
    ],
    "watch": [
      "dist/index.js"
    ],
    "exec": "node ./dist/index.js",
    "ext": "ts,yaml,json",
    "delay": "500"
  },
  "engines": {
    "node": "^22.0.0"
  }
}
