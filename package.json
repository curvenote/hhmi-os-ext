{
  "name": "hhmi-os-ext",
  "private": true,
  "version": "0.0.1",
  "description": "HHMI Workspace extension modules - powered by Curvenote.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "changeset": "changeset",
    "version": "changeset version",
    "publish": "bun run clean && bun run build -- --force && changeset publish && git push --follow-tags",
    "publish:ci": "bun run build && changeset publish && git push --follow-tags",
    "build": "turbo run build",
    "clean": "turbo run clean",
    "lint": "bun run --filter './packages/*' lint",
    "lint:format": "bun run --filter './packages/*' lint:format",
    "lint:format:fix": "bun run --filter './packages/*' lint:format:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "eslint-config-curvenote": "^0.0.4",
    "turbo": "^2.0.0"
  },
  "dependencies": {
    "@changesets/changelog-github": "^0.5.1"
  },
  "engines": {
    "node": ">=22.21.0",
    "bun": ">=1.3.10"
  },
  "packageManager": "bun@1.3.10"
}
